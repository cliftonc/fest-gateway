{
  "name": "fest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted Claude Code gateway: per-user subscription pass-through, central token/cost monitoring, model routing.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "fest": "./server/bin/fest.ts"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "open": "^11.0.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "start": "node --env-file-if-exists=.env server/bin/fest.ts serve",
    "cli": "node --env-file-if-exists=.env server/bin/fest.ts",
    "build": "vite build",
    "capture": "node tools/capture-server.ts",
    "canary": "node tools/canary.ts",
    "prices:sync": "node tools/prices-sync.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "seed": "node --env-file-if-exists=.env server/bin/fest.ts seed",
    "demo": "FEST_DB=./data/demo.db FEST_USAGE_LOG=./data/demo.jsonl node --env-file-if-exists=.env server/bin/fest.ts seed --reset && FEST_DB=./data/demo.db FEST_USAGE_LOG=./data/demo.jsonl node tools/dev.mjs",
    "demo:clean": "FEST_DB=./data/demo.db FEST_USAGE_LOG=./data/demo.jsonl node --env-file-if-exists=.env server/bin/fest.ts seed --clear && rm -f ./data/demo.jsonl"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^0.18.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
  }
}

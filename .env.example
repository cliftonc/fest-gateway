# Copy to `.env` — which is gitignored — and fill in.
#
# Nothing here is read by Fest directly. The routing table references these by
# NAME (`{env:FIREWORKS_API_KEY}`), so the value never appears in config, never
# reaches the database, and never reaches the dashboard. What Fest records is
# the reference: `env:FIREWORKS_API_KEY`.
#
# `npm run dev`, `npm start` and `npm run demo` load this file via Node's own
# --env-file-if-exists. No dotenv dependency, and no failure if it is absent.

# Server-held credential for substitute routes. Only needed if a route in
# routes.json targets the `fireworks` upstream.
FIREWORKS_API_KEY=

# ── Fest's own settings (all optional; defaults shown) ──────────────────────
# FEST_PORT=8787
# FEST_HOST=127.0.0.1
# FEST_DB=./data/fest.db
# FEST_LOG_LEVEL=info

# Path to the routing table. Unset means every request passes through to
# Anthropic on the caller's own credential — the safe default.
# FEST_ROUTES=./routes.json

# Set this to true for any deployment with more than one developer, or usage
# arrives unattributed and the gateway cannot tell you who spent what.
# FEST_REQUIRE_IDENTITY=false

# ── Google/GitHub OAuth, for `fest login` and the dashboard's sign-in buttons ─
# Optional per-provider: set a provider's id+secret to turn it on, leave both
# unset to leave that provider off entirely. See docs/CLI-AUTH.md.
# FEST_GOOGLE_CLIENT_ID=
# FEST_GOOGLE_CLIENT_SECRET=
# FEST_GITHUB_CLIENT_ID=
# FEST_GITHUB_CLIENT_SECRET=

# Base URL Fest is reachable at, used to build the OAuth redirect URI.
# Defaults to http://<FEST_HOST>:<FEST_PORT>, which is wrong for anything
# behind a proxy or a real domain.
# FEST_PUBLIC_URL=https://fest.corp.test

# REQUIRED to turn OAuth on at all — comma-separated email domains allowed to
# self-mint a token or dashboard session. Unset/empty refuses every OAuth
# login rather than allowing any Google/GitHub account on the internet.
# FEST_ALLOWED_EMAIL_DOMAINS=corp.test

# ── For developers pointing Claude Code at Fest ─────────────────────────────
# These go in the DEVELOPER's shell, not in this file. Or, if OAuth is
# configured above, skip all of this:
#     npx fest login --server http://127.0.0.1:8787
#     npx fest claude
#
#   Subscription posture (preferred — bills their own Claude plan):
#     ANTHROPIC_BASE_URL=http://127.0.0.1:8787/t/<their-token>
#
#   Key posture (bills the org, but gets a model menu in /model):
#     ANTHROPIC_BASE_URL=http://127.0.0.1:8787
#     ANTHROPIC_AUTH_TOKEN=<their-token>
#     CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
#
# ⚠ Do NOT set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN here or anywhere in a
# developer's environment. Either one makes Claude Code stop using the
# developer's Max/Team subscription and silently bill an API key instead.

# Copy to `.env` — which is gitignored — and fill in.
#
# Nothing here is read by Fest directly. The routing table references these by
# NAME (`{env:FIREWORKS_API_KEY}`), so the value never appears in config, never
# reaches the database, and never reaches the dashboard. What Fest records is
# the reference: `env:FIREWORKS_API_KEY`.
#
# `npm run dev`, `npm start` and `npm run demo` load this file via Node's own
# --env-file-if-exists. No dotenv dependency, and no failure if it is absent.

# Server-held credential for substitute routes. Only needed if a route in
# routes.json targets the `fireworks` upstream.
FIREWORKS_API_KEY=

# ── Fest's own settings (all optional; defaults shown) ──────────────────────
# FEST_PORT=8787
# FEST_HOST=127.0.0.1
# FEST_DB=./data/fest.db
# FEST_LOG_LEVEL=info

# Path to the routing table. Unset means every request passes through to
# Anthropic on the caller's own credential — the safe default.
# FEST_ROUTES=./routes.json

# Set this to true for any deployment with more than one developer, or usage
# arrives unattributed and the gateway cannot tell you who spent what.
# FEST_REQUIRE_IDENTITY=false

# ⚠ Do NOT set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN here or anywhere in a
# developer's environment. Either one makes Claude Code stop using the
# developer's Max/Team subscription and silently bill an API key instead.
